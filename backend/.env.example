PORT=5000
NODE_ENV=development

# Leave DATABASE_URL empty to use backend/data/db.json for a local demo.
# Set this only for your own PostgreSQL database after running migrations.
DATABASE_URL=
PG_SSL_MODE=verify-full
# Optional PEM trust certificate for a private PostgreSQL CA.
# PG_SSL_CA_FILE=/run/secrets/postgres-ca.pem
PG_MIGRATION_RETRIES=20
PG_MIGRATION_RETRY_MS=1500
# Background dispatch-escalation sweep interval (min 5000). Each sweep flips expired
# primary-ACK timeouts and dispatches backup units. Multi-instance safe via advisory lock.
ESCALATION_SWEEP_INTERVAL_MS=15000
JWT_SECRET=replace_with_a_long_random_secret_for_local_development

# Encryption key for camera credentials at rest (stream URLs, usernames, passwords).
# Required in production; also required before storing real camera credentials in
# development. Credential-free demo cameras work without it. Generate a key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit a real key. Rotating it makes previously encrypted credentials unreadable.
# CAMERA_CREDENTIAL_ENCRYPTION_KEY=replace_with_64_hex_chars
CAMERA_CREDENTIAL_ENCRYPTION_KEY=
EVIDENCE_STORAGE_DRIVER=filesystem
# Production filesystem storage requires a durable mounted path.
# EVIDENCE_STORAGE_DIR=./storage/evidence

# Leave empty to run without AI, or start ai-service on port 8000 and set:
# AI_SERVICE_URL=http://127.0.0.1:8000
# AI_SERVICE_API_KEY is required whenever AI_SERVICE_URL is set; startup fails otherwise.
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
# Explicit opt-in for local development WITHOUT an API key. Never enable in production. Default: false.
AI_SERVICE_ALLOW_INSECURE=false
AI_SERVICE_TIMEOUT_MS=8000
AI_HEALTH_TIMEOUT_MS=3000
# Real CCTV stream secrets must stay backend-side only.
# Use authorized cameras only; do not add public CCTV streams.
# RTSP_CAMERA_URLS=["rtsp://<user>:<password>@<camera-host>/<path>"]
# Production routing must use a private/self-hosted OSRM endpoint.
# For local demos only, set GIS_ROUTING_PROVIDER=public and PUBLIC_OSRM_FALLBACK=true.
GIS_ROUTING_PROVIDER=self_hosted
OSRM_BASE_URL=http://127.0.0.1:5001
PUBLIC_OSRM_FALLBACK=false
ROUTE_TIMEOUT_MS=3000
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_COUNTRY_CODES=in
MAP_USER_AGENT=RakshakAI/1.0 public-safety-command-center
JSON_BODY_LIMIT=1.5mb
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=10
PASSWORD_CHANGE_RATE_LIMIT=10
# Dedicated AI frame analysis budget per minute (Live Vision samples at 800-1500 ms).
AI_FRAME_RATE_LIMIT=300
TRUST_PROXY=0
# RAKSHAKAI_DATA_FILE is intended for isolated local/test JSON storage only.
# RAKSHAKAI_DATA_FILE=
CORS_ORIGIN=

# Optional CSP additions for HTML-serving layers and backend Helmet.
# Leave CSP_CONNECT_SRC empty when the frontend reaches the backend through same-origin /api.
# Values must be origins only; production rejects wildcards, unsafe-eval, paths, and non-HTTPS origins.
# CSP_CONNECT_SRC=https://api.example.com
# CSP_IMG_SRC=https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org
CSP_CONNECT_SRC=
CSP_IMG_SRC=
