PORT=5000
NODE_ENV=development

# Leave DATABASE_URL empty to use backend/data/db.json for a local demo.
# Set this only for your own PostgreSQL database after running migrations.
DATABASE_URL=
PG_SSL_MODE=require
PG_MIGRATION_RETRIES=20
PG_MIGRATION_RETRY_MS=1500
JWT_SECRET=replace_with_a_long_random_secret_for_local_development

# Leave empty to run without AI, or start ai-service on port 8000 and set:
# AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=8000
AI_HEALTH_TIMEOUT_MS=3000
# Real CCTV stream secrets must stay backend-side only.
# Use authorized cameras only; do not add public CCTV streams.
# RTSP_CAMERA_URLS=["rtsp://<user>:<password>@<camera-host>/<path>"]
# Production routing must use a private/self-hosted OSRM endpoint.
# For local demos only, set GIS_ROUTING_PROVIDER=public and PUBLIC_OSRM_FALLBACK=true.
GIS_ROUTING_PROVIDER=self_hosted
OSRM_BASE_URL=http://127.0.0.1:5001
PUBLIC_OSRM_FALLBACK=false
ROUTE_TIMEOUT_MS=3000
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_COUNTRY_CODES=in
MAP_USER_AGENT=RakshakAI/1.0 public-safety-command-center
JSON_BODY_LIMIT=1.5mb
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=10
PASSWORD_CHANGE_RATE_LIMIT=10
TRUST_PROXY=0
# RAKSHAKAI_DATA_FILE is intended for isolated local/test JSON storage only.
# RAKSHAKAI_DATA_FILE=
CORS_ORIGIN=

# Optional CSP additions for HTML-serving layers and backend Helmet.
# Leave CSP_CONNECT_SRC empty when the frontend reaches the backend through same-origin /api.
# Values must be origins only; production rejects wildcards, unsafe-eval, paths, and non-HTTPS origins.
# CSP_CONNECT_SRC=https://api.example.com
# CSP_IMG_SRC=https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org
CSP_CONNECT_SRC=
CSP_IMG_SRC=
