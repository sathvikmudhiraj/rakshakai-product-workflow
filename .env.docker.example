POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Camera credential encryption-at-rest key (64 hex chars = 32 bytes). Production startup
# fails without it. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CAMERA_CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-chars
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_POLICE_PASSWORD=replace-with-a-strong-police-password
SEED_CITIZEN_PASSWORD=replace-with-a-strong-citizen-password
AI_SERVICE_API_KEY=replace-with-a-random-api-key
# Dedicated AI frame analysis budget per minute (Live Vision samples at 800-1500 ms).
AI_FRAME_RATE_LIMIT=300
# Explicit opt-in for local development WITHOUT an API key. Never enable in production. Default: false.
AI_SERVICE_ALLOW_INSECURE=false
EVIDENCE_STORAGE_DRIVER=filesystem
EVIDENCE_STORAGE_DIR=/app/backend/storage/evidence
GIS_ROUTING_PROVIDER=self_hosted
# Normal startup leaves the optional OSRM profile inactive. Route requests use
# the backend's approximate fallback until prepared OSRM is explicitly started.
OSRM_BASE_URL=http://osrm:5000
PUBLIC_OSRM_FALLBACK=false
ROUTE_TIMEOUT_MS=3000
# Required only with: docker compose --env-file .env.docker --profile osrm up -d --build
# Prepare regional files explicitly. Large map data is never downloaded automatically.
OSRM_DATA_HOST_PATH=D:\rakshak-gis\osrm-data
OSRM_DATA_PATH=/data/region.osrm
CSP_CONNECT_SRC=
CSP_IMG_SRC=
# Optional authorized CCTV placeholders only. Keep real values in .env.docker or Docker secrets.
# RTSP_CAMERA_URLS=["rtsp://<user>:<password>@<camera-host>/<path>"]
