PORT=4173

# Real CCTV / RTSP
# Comma, semicolon, newline, or JSON array accepted.
RTSP_CAMERA_URLS=rtsp://username:password@camera-ip:554/stream1

# Python AI service
# Run real-product/ai-service and point this URL to it.
AI_SERVICE_URL=http://127.0.0.1:8000

# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Firebase Cloud Messaging
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_TOPIC=/topics/rakshakai-alerts

# Production auth/session secret
JWT_SECRET=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_a_long_random_secret

# Routing engine. Public OSRM works for demo; use a private OSRM server for production.
OSRM_BASE_URL=https://router.project-osrm.org

# Deployment markers
VERCEL_URL=
RENDER_EXTERNAL_URL=
