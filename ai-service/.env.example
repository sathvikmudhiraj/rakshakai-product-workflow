HOST=127.0.0.1
PORT=8000
# Authentication is required by default (fail closed). /health stays public for container health checks.
AI_SERVICE_API_KEY=
# Explicit opt-in for local development WITHOUT an API key. Never enable in production. Default: false.
AI_SERVICE_ALLOW_INSECURE=false
# Optional SHA-256 of the configured YOLO weights file; startup fails closed on mismatch.
# YOLO_MODEL_SHA256=<sha256-of-yolov8n.pt>
YOLO_MODEL_NAME=yolov8n.pt
YOLO_MIN_CONFIDENCE=0.50
YOLO_IMAGE_SIZE=640
YOLO_MAX_DETECTIONS=30
YOLO_DEVICE=cpu
AI_DUPLICATE_WINDOW_SECONDS=8
AI_TRACK_TTL_SECONDS=15
# Optional: requires a locally installed/legal OCR runtime. Disabled by default.
PLATE_OCR_ENABLED=false
